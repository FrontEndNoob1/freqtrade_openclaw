  - name: Setup Python
    uses: actions/setup-python@v4
    with:
      python-version: '3.11'

  - name: Create venv & install Python deps
    run: |
      python -m venv .venv
      . .venv/bin/activate
      python -m pip install --upgrade pip setuptools wheel
      pip install -r requirements.txt

  - name: Run tests (fast subset)
    run: |
      . .venv/bin/activate
      # Run pytest on the tests folder with a short selection; adjust as needed
      pytest -q tests -k "not integration and not slow" --maxfail=1 --disable-warnings

  - name: Lint (optional)
    run: |
      . .venv/bin/activate
      pip install pylint
      pylint freqtrade || true

